    {"name":"dpo+chosen","alpha":0.25,"gamma":0.0},
    {"name":"dpo+rehearsal","alpha":0.0,"gamma":0.25},
    {"name":"dpo+chosen+rehearsal","alpha":0.25,"gamma":0.25}
  ],
  "conditions": ["clean","noisy","chosen-longer","matched-long"],
